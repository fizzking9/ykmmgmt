# Development environment — copy to .env and adjust.
# Production deployment uses deploy/.env.prod instead (see deploy/README.md).

# PostgreSQL in the dev docker-compose.yml (host port 15432)
DATABASE_URL=postgresql+asyncpg://ykmmgmt:ykmmgmt@127.0.0.1:15432/ykmmgmt
# JWT signing key — generate a long random string for production
SECRET_KEY=change-me-to-a-long-random-string
# Initial root (super admin) account, created by `python -m scripts.seed_root`
ROOT_USERNAME=root
ROOT_PASSWORD=change-me

# ── MCP server (dev) ──────────────────────────────────────────────────────
# Used by scripts/dev.ps1 to run the MCP server natively against the dev
# backend. YKM_SERVICE_* must be a real backend account (create one via the
# user management UI); YKM_MCP_API_KEY is what MCP clients must send as
# `Authorization: Bearer <key>` to reach http://127.0.0.1:8001/mcp.
YKM_SERVICE_USERNAME=svc-mcp
YKM_SERVICE_PASSWORD=change-me
YKM_MCP_API_KEY=change-me
# Base URL for download links returned by export_visualizations; leave
# empty for relative links (fine for local dev).
#YKM_MCP_PUBLIC_URL=http://127.0.0.1:8001/mcp

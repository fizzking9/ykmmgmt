# Development environment — copy to .env and adjust.
# Production deployment uses deploy/.env.prod instead (see deploy/README.md).

# PostgreSQL in the dev docker-compose.yml (host port 15432)
DATABASE_URL=postgresql+asyncpg://ykmmgmt:ykmmgmt@127.0.0.1:15432/ykmmgmt
# JWT signing key — generate a long random string for production
SECRET_KEY=change-me-to-a-long-random-string
# Initial root (super admin) account, created by `python -m scripts.seed_root`
ROOT_USERNAME=root
ROOT_PASSWORD=change-me

# ── MCP server (dev) ──────────────────────────────────────────────────────
# Used by scripts/dev.ps1 to run the MCP server natively against the dev
# backend. YKM_SERVICE_* must be a real backend account (create one via the
# user management UI); YKM_MCP_API_KEY is what MCP clients must send as
# `Authorization: Bearer <key>` to reach http://127.0.0.1:8001/mcp.
YKM_SERVICE_USERNAME=svc-mcp
YKM_SERVICE_PASSWORD=change-me
YKM_MCP_API_KEY=change-me
# Base URL for download links returned by export_visualizations; leave
# empty for relative links (fine for local dev).
#YKM_MCP_PUBLIC_URL=http://127.0.0.1:8001/mcp

# ── Semantic Q&A chat widget ────────────────────────────────────────────────
# Bootstrap encoder for chat embeddings: used while the knowledge base has no
# vectors yet. Admins switch it on 问答管理 (候选列表见 app/services/embedding_models.py),
# which rebuilds every stored vector in the same action; once rows carry a model,
# that model wins over this value after a restart. The chosen encoder's weights
# must already exist on the server (image bake or a mounted HF_HOME), and after a
# switch re-run scripts/tune_chat_threshold.py to re-calibrate the threshold below.
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# Minimum cosine similarity to accept a match; below → friendly fallback.
# Tuned via scripts/tune_chat_threshold.py on the frozen eval set: 0.79 gives
# precision 1.00 / recall 0.43 on the 5-phrasing KB and 1.00 / 0.767 after seeding 9
# more 相似问法 — the latter only holds because the time-window guard
# (app/services/time_window.py) refuses answers from a different period (上周 vs 本周
# score 0.88 apart to an embedding). Without that guard the seeded KB needs ~0.89.
# Re-run the tuner after every KB or encoder change; the value is model-specific.
CHAT_SIMILARITY_THRESHOLD=0.79
# Weights are baked into the image at build time (Dockerfile BAKE_MODEL), so loading
# stays offline; a cold cache on a blocked network would otherwise stall the first
# encode for minutes. Set true only to fetch a new 向量模型 candidate at runtime.
EMBEDDING_ALLOW_DOWNLOAD=false
# How far below the threshold still counts as a "near miss" in the ask log,
# for the weekly review loop. Widen to catch more misses.
CHAT_LOG_NEAR_THRESHOLD_WINDOW=0.10

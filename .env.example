# Development environment — copy to .env and adjust.
# Production deployment uses deploy/.env.prod instead (see deploy/README.md).

# PostgreSQL in the dev docker-compose.yml (host port 15432)
DATABASE_URL=postgresql+asyncpg://ykmmgmt:ykmmgmt@127.0.0.1:15432/ykmmgmt
# JWT signing key — generate a long random string for production
SECRET_KEY=change-me-to-a-long-random-string
# Initial root (super admin) account, created by `python -m scripts.seed_root`
ROOT_USERNAME=root
ROOT_PASSWORD=change-me

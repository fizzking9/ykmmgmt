# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
*.egg
.venv/
venv/

# Node
node_modules/
dist/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Production deployment secrets (deploy/.env.prod.example is tracked)
deploy/.env.prod

# Deployment
# frp tunnel config contains the shared token — only the .example is tracked
deploy/frpc.toml

# Database backups (scripts/backup-db.ps1)
backups/

# Container file logs (logs/backend, logs/db, logs/frpc)
logs/

# Build
*.log
# setuptools build dirs (e.g., ykmmgmt/mcp_server/build after pip wheel)
build/

# Sample data (not tracked)
*.csv
*.xlsx

# Debug/export scratch artifacts
tmp_export/

# Runtime-generated schema migrations (created by the Schema Manager at
# runtime; dynamic tables are restored from DB reflection on startup)
ykmmgmt/runtime_migrations/

# Agent tool artifacts (not project code)
.agents/
skills-lock.json

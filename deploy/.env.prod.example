# Production deployment variables — copy to deploy/.env.prod and fill in.
# Used by docker-compose.prod.yml (via scripts/deploy.ps1).
# deploy/.env.prod is git-ignored; never commit real secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=ykmmgmt
POSTGRES_DB=ykmmgmt
# Generate a strong password: e.g. PowerShell:
#   -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | % {[char]$_})
POSTGRES_PASSWORD=change-me

# ── Backend ────────────────────────────────────────────────────────────────
# JWT signing key — long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# Initial root (super admin) account, created by the backend on first boot
# (see scripts/seed_root.py; the container runs it when ROOT_USERNAME is set).
ROOT_USERNAME=root
ROOT_PASSWORD=change-me

# Log output: "json" (structured, production) or "text" (readable)
LOG_FORMAT=json

# ── Images (GitHub Container Registry) ────────────────────────────────────
# Replace <owner> with the GitHub account/org that owns the repo.
BACKEND_IMAGE=ghcr.io/<owner>/ykmmgmt-backend:latest
FRONTEND_IMAGE=ghcr.io/<owner>/ykmmgmt-frontend:latest
MCP_IMAGE=ghcr.io/<owner>/ykmmgmt-mcp:latest

# ── Host port for the frontend Nginx ──────────────────────────────────────
FRONTEND_PORT=8080

# ── MCP server (Phase 14) ───────────────────────────────────────
# Backend service account the MCP server logs in as — a regular user
# (e.g. an admin) created via the user management UI.
YKM_SERVICE_USERNAME=svc-mcp
YKM_SERVICE_PASSWORD=change-me
# API key external AI agents must present (Authorization: Bearer <key>).
# Generate a strong one, e.g.:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
YKM_MCP_API_KEY=change-me
# Public base URL for the download links export_visualizations returns —
# must be the externally reachable MCP address agents connect to.
YKM_MCP_PUBLIC_URL=http://<CLOUD_SERVER_IP>/mcp
# Where exported files await download inside the mcp_server container
# (/exports is bind-mounted to ./mcp_exports on the host).
YKM_MCP_FILES_DIR=/exports

# ── Semantic Q&A chat widget (backend) ─────────────────────────────────────
# These bind to app/core/config.py Settings by bare name (YKM_CHAT_SIMILARITY_THRESHOLD
# and YKM_EMBEDDING_ALLOW_DOWNLOAD are accepted too). The default encoder's weights are
# baked into the backend image at build time, so keep downloads off in production;
# switching encoder on 问答管理 rebuilds all vectors but needs the new weights present.
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# Tuned operating point on the seeded KB (precision 1.00 / recall 0.767 on the frozen
# eval set). It is safe at 0.79 only because the time-window guard refuses a match
# whose calendar period contradicts the question (app/services/time_window.py).
# Re-run scripts/tune_chat_threshold.py after any KB or encoder change on this host.
CHAT_SIMILARITY_THRESHOLD=0.79
EMBEDDING_ALLOW_DOWNLOAD=false

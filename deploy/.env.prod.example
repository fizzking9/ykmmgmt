# Production deployment variables — copy to deploy/.env.prod and fill in.
# Used by docker-compose.prod.yml (via scripts/deploy.ps1).
# deploy/.env.prod is git-ignored; never commit real secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=ykmmgmt
POSTGRES_DB=ykmmgmt
# Generate a strong password: e.g. PowerShell:
#   -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | % {[char]$_})
POSTGRES_PASSWORD=change-me

# ── Backend ────────────────────────────────────────────────────────────────
# JWT signing key — long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# Initial root (super admin) account, created by the backend on first boot
# (see scripts/seed_root.py; the container runs it when ROOT_USERNAME is set).
ROOT_USERNAME=root
ROOT_PASSWORD=change-me

# Log output: "json" (structured, production) or "text" (readable)
LOG_FORMAT=json

# ── Images (GitHub Container Registry) ────────────────────────────────────
# Replace <owner> with the GitHub account/org that owns the repo.
BACKEND_IMAGE=ghcr.io/<owner>/ykmmgmt-backend:latest
FRONTEND_IMAGE=ghcr.io/<owner>/ykmmgmt-frontend:latest

# ── Host port for the frontend Nginx ──────────────────────────────────────
FRONTEND_PORT=8080
